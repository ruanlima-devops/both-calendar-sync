# App (Expo) — public only
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_APP_URL=http://localhost:8081
# RevenueCat public SDK keys (never secret keys)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional EAS
EAS_PROJECT_ID=
EAS_OWNER=

APP_URL=http://localhost:8081
# Comma-separated https origins allowed as OAuth return (in addition to APP_URL)
APP_REDIRECT_ALLOWLIST=

# Login uses Supabase Auth → Google (+ Apple on iOS).
# Do not put Google/Apple Client Secret in the Expo app.
# Calendar OAuth below is a separate integration.

# Edge Functions / Cron (never expose to the client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=change-me

# Google Calendar OAuth — NOT used for Unify login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/google-oauth
GOOGLE_WEBHOOK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/google-webhook

# Microsoft Graph OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/microsoft-oauth
MICROSOFT_WEBHOOK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/microsoft-webhook

# Email digests (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Unify <digest@yourdomain.com>

# Billing — Stripe (Web only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Trial length for NEW accounts: billing_settings.trial_days (default 14)

# Billing — RevenueCat webhook (mobile)
REVENUECAT_WEBHOOK_SECRET=

# iCloud Calendar uses CalDAV + user app-specific passwords (no Apple OAuth client secret).
# Schedule Edge Function icloud-poll every ~1 minute with CRON_SECRET (see docs/deploy).
